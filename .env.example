# MySQL 8 (AWS RDS while the game was live); this URL fits the local container in the README's Run steps
DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/wjmax_db
# set to 1 to serve /docs while developing
ENABLE_DOCS=0
# titles the game client spells differently from music_tb, as a JSON object (empty: none), e.g.
# TITLE_ALIASES={"title as the client sends it":"title in music_tb"}
# (quote the value when a shell reads this file and it holds spaces)
TITLE_ALIASES=
